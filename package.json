{
  "name": "paperwork-pdf-studio",
  "version": "0.2.7",
  "description": "Paperwork PDF Studio",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "PDF Factory",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:dir": "tauri build --no-bundle",
    "build:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis",
    "build:dir:arm64": "tauri build --target aarch64-pc-windows-msvc --no-bundle",
    "preview": "vite preview",
    "test": "vitest run",
    "generate:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-app-icon.ps1",
    "verify:release-signatures": "powershell -NoProfile -ExecutionPolicy Bypass -File build/verify-release-signatures.ps1",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:web": "tsc --noEmit && vite build",
    "build:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "dev:electron": "vite --mode electron",
    "build:electron": "tsc --noEmit && vite build --mode electron && electron-builder",
    "build:electron:arm64": "tsc --noEmit && vite build --mode electron && electron-builder --win --arm64 --config electron-builder.arm64.yml",
    "verify:workbench": "node scripts/verify-workbench.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.4",
    "@tanstack/react-virtual": "3.14.26",
    "@tauri-apps/api": "2.11.1",
    "fflate": "0.8.2",
    "lucide-react": "^0.468.0",
    "onnxruntime-node": "^1.22.0",
    "paddleocr": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qpdf-run": "0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xmldom/xmldom": "0.9.12",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright-core": "1.65.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "studio.paperwork.pdf",
    "productName": "Paperwork PDF Studio",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/paddleocr/dist/*.mjs",
      "node_modules/paddleocr/dist/*.cjs",
      "node_modules/paddleocr/package.json",
      "node_modules/onnxruntime-common/dist/**/*.js",
      "node_modules/onnxruntime-common/dist/**/package.json",
      "node_modules/onnxruntime-common/package.json",
      "node_modules/onnxruntime-node/dist/**/*.js",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*",
      "node_modules/onnxruntime-node/package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "extraResources": [
      {
        "from": "build/virtual-printer.ps1",
        "to": "virtual-printer.ps1"
      },
      {
        "from": "resources/ocr",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF 文档",
        "description": "Portable Document Format",
        "role": "Editor",
        "icon": "pdf.ico"
      },
      {
        "ext": "ofd",
        "name": "OFD 版式文档",
        "description": "Open Fixed-layout Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg"
        ],
        "name": "图片文件",
        "description": "PNG 或 JPEG 图片",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "include": "build/installer.nsh"
    }
  }
}
